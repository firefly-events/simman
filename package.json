{
  "name": "simman",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Firefly Events",
  "description": "SimMan (Simulated Manual) — selectorless vision-cursor testing for web. A vision model is the eyes, a real cursor is the hands.",
  "keywords": ["testing", "e2e", "vision", "gemini", "playwright", "selectorless", "qa"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firefly-events/simman.git"
  },
  "type": "module",
  "bin": {
    "simman": "bin/simman"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test engine/__tests__/*.test.mjs gate/__tests__/*.test.mjs cli/__tests__/*.test.mjs"
  },
  "dependencies": {
    "js-yaml": "4.2.0",
    "playwright": "1.52.0"
  }
}
