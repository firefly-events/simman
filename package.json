{
  "name": "simman",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Firefly Events",
  "description": "SimMan (Simulated Manual) — selectorless vision-cursor testing for web. A vision model is the eyes, a real cursor is the hands.",
  "keywords": ["testing", "e2e", "vision", "gemini", "playwright", "selectorless", "qa"],
  "homepage": "https://github.com/firefly-events/simman#readme",
  "bugs": "https://github.com/firefly-events/simman/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firefly-events/simman.git"
  },
  "type": "module",
  "bin": {
    "simman": "bin/simman"
  },
  "files": [
    "bin",
    "cli",
    "engine",
    "gate",
    "agent",
    "scenarios",
    "docs",
    "simman.config.example.yaml",
    "NOTICE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "!**/__pycache__/**",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test engine/__tests__/*.test.mjs gate/__tests__/*.test.mjs cli/__tests__/*.test.mjs"
  },
  "dependencies": {
    "js-yaml": "4.2.0",
    "playwright": "1.52.0"
  }
}
